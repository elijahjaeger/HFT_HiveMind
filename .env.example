# Optional, non-secret overrides. Copy to `.env` if you want them.
#
# This project is SIMULATION ONLY. The venue adapters issue read-only HTTP GET
# requests to PUBLIC market-data endpoints, so there are no API keys, tokens or
# account identifiers here - and none are ever required or accepted. Do not add
# credentials to this project.
#
# Every value below simply overrides a field in config/settings.yaml.

# Seed for the synthetic demo-data generator (reproducibility).
HIVEMIND_SEED=20240617

# Number of demo markets to generate (minimum 3).
HIVEMIND_N_MARKETS=8

# Starting capital for the simulated portfolio, in dollars.
HIVEMIND_INITIAL_CAPITAL=10000

# Global halt: when true, the risk agent rejects every proposal.
HIVEMIND_KILL_SWITCH=false

# Where the local DuckDB cache of the demo data lives.
HIVEMIND_DUCKDB_PATH=data/processed/demo.duckdb
